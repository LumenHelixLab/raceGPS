{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@racegps/launcher-settings": ["../../packages/launcher-settings/src/index.ts"]
    }
  },
  "include": ["electron/**/*.ts", "electron.vite.config.ts"]
}
